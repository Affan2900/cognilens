{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Only environment-independent values belong here. Anything pointing at a specific
  // machine or a specific Azure resource lives in appsettings.Development.json (local) or
  // arrives as an env var from aca.bicep (deployed) — a dev default in this file silently
  // wins in production whenever the deployment forgets to override it. PublicBlobEndpoint
  // is the sharpest example: left here it rewrote every deployed upload SAS URL to
  // http://localhost:10000, handing clients an address on their own machine.
  "Storage": {
    "ContainerName": "call-audio",
    "QueueName": "analyze-jobs",
    "PoisonQueueName": "analyze-jobs-poison"
  },
  "AzureAi": {
    "Speech": {
      "Locale": "en-US"
    },
    "OpenAi": {
      "ChatDeploymentName": "gpt-5-mini",
      "EmbeddingDeploymentName": "text-embedding-3-small"
    },
    "Search": {
      "IndexName": "transcript-chunks"
    }
  }
}
