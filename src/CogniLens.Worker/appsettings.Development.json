{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  // Local-only. Never loaded in Production, so none of this can leak into a deployed app.
  // docker-compose.yml sets Storage__ConnectionString itself (pointing at the azurite
  // container rather than localhost); these values are for a bare `dotnet run`.
  "ConnectionStrings": {
    "CogniLensDb": "Server=localhost,1433;Database=CogniLens;User Id=sa;Password=DevPassword1!;TrustServerCertificate=True"
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "AzureAi": {
    "Speech": {
      "Endpoint": "https://cognilens-speech-dev.cognitiveservices.azure.com/"
    },
    "OpenAi": {
      "Endpoint": "https://cognilens-openai-dev.openai.azure.com/"
    },
    "Search": {
      "Endpoint": "https://cognilens-search-dev.search.windows.net"
    }
  }
}
